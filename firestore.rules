rules_version = '2';

// Security rules for Parakeet Bank. Deploy with:  firebase deploy --only firestore:rules
// (or paste them into Firebase console → Firestore → Rules).
//
// LEARNING NOTE: a real bank would never let the browser change balances. It would do all
// money movement on a server (e.g. Cloud Functions). These rules are a sensible middle ground
// for a learning project: users can't change their role/status, frozen profiles can't move
// money, and other users can only ever INCREASE your checking/savings (incoming transfers).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.accounts.chk.balance == 0
        && request.resource.data.accounts.sav.balance == 0;

      allow update: if isAdmin()
        // Owner: edit profile fields, or move money while the profile is active.
        || (signedIn() && request.auth.uid == uid
            && changed().hasOnly(['fullName', 'phone', 'address', 'avatarColor', 'accounts', 'updatedAt'])
            && (!changed().hasAny(['accounts']) || resource.data.status == 'active'))
        // Anyone signed in: an incoming transfer to checking or savings, balance can only go up.
        || (signedIn() && request.auth.uid != uid
            && resource.data.status == 'active'
            && changed().hasOnly(['accounts', 'updatedAt'])
            && request.resource.data.accounts.diff(resource.data.accounts).affectedKeys().hasOnly(['chk', 'sav'])
            && request.resource.data.accounts.chk.balance >= resource.data.accounts.chk.balance
            && request.resource.data.accounts.get('sav', {'balance': 0}).balance >= resource.data.accounts.get('sav', {'balance': 0}).balance);

      allow delete: if isAdmin();
    }

    // Public directory: account number -> name, used to look up transfer recipients.
    match /accounts/{accountNumber} {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);
    }

    match /transactions/{txId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.uid == request.auth.uid)
        // the sender writes the recipient's "transfer_in" record
        || (signedIn() && request.resource.data.type == 'transfer_in'
            && request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
