# Used by `npm run dev:emulators`: connects the app to the local Firebase emulators
# started with `npm run emulators`. Safe to commit — these are not real keys.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-parakeet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-parakeet
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_EMULATORS=true
